{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "agent-reality-in",
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          { "id": "REPLACE_WITH_GENERATED_UUID", "flow": "xtls-rprx-vision" }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "REPLACE_WITH_VALIDATED_TLS_HOST:443",
          "xver": 0,
          "serverNames": ["REPLACE_WITH_VALIDATED_TLS_HOST"],
          "privateKey": "REPLACE_WITH_GENERATED_PRIVATE_KEY",
          "shortIds": ["REPLACE_WITH_GENERATED_SHORT_ID"]
        }
      }
    }
  ],
  "outbounds": [
    { "tag": "internet", "protocol": "freedom" },
    { "tag": "blocked", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "IPOnDemand",
    "rules": [
      {
        "type": "field",
        "ip": [
          "0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8",
